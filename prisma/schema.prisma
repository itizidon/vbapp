generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MatchStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum FeedbackStatus {
  REJECTED
  PENDING
  PUBLISHED
  HIDDEN
  DELETED
}

model User {
  id                String                       @id @default(uuid()) @db.Uuid
  username          String                       @unique @db.Citext
  email             String                       @unique @db.Citext
  isPublic          Boolean                      @default(false)
  passwordHash      String
  age               Int
  heightCm          Int
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  createdMatches    Match[]                      @relation("MatchCreator")
  matchParticipants MatchParticipant[]
  receivedFeedback  Feedback[]                   @relation("FeedbackRecipient")
  submittedFeedback Feedback[]                   @relation("FeedbackReviewer")
  selfAssessments   SelfAssessment[]
  internalRatings   PlayerInternalRating[]
  selfRatingEvents  SelfAssessmentRatingEvent[]
  internalReviews   InternalRatingContribution[] @relation("InternalReviewer")
  feedbackLinks     FeedbackLink[]               @relation("LinkRecipient")
  assignedLinks     FeedbackLink[]               @relation("LinkReviewer")
  preparedFeedback  Feedback[]                   @relation("FeedbackSubmitter")
  approvedFeedback  Feedback[]                   @relation("FeedbackApprover")
  rejectedFeedback  Feedback[]                   @relation("FeedbackRejector")
  feedbackAnalysisProfiles PlayerFeedbackAnalysisProfile[]
  aiCoachConversations AiCoachConversation[]
  aiCoachTurns AiCoachTurn[]
  aiCoachUsage AiCoachUsage[]
}

model Sport {
  feedbackLinks   FeedbackLink[]
  id              String           @id @default(uuid()) @db.Uuid
  name            String
  slug            String           @unique
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  skills          Skill[]
  matches         Match[]
  feedback        Feedback[]
  selfAssessments SelfAssessment[]
  feedbackAnalysisProfiles PlayerFeedbackAnalysisProfile[]
  aiCoachConversations AiCoachConversation[]
}

model Skill {
  id                        String                          @id @default(uuid()) @db.Uuid
  sportId                   String                          @db.Uuid
  name                      String
  slug                      String
  description               String?
  active                    Boolean                         @default(true)
  requiredForSelfAssessment Boolean                         @default(false)
  createdAt                 DateTime                        @default(now())
  updatedAt                 DateTime                        @updatedAt
  sport                     Sport                           @relation(fields: [sportId], references: [id], onDelete: Restrict)
  feedbackRatings           FeedbackRating[]
  selfAssessmentRatings     SelfAssessmentRating[]
  reviewerSnapshots         FeedbackReviewerSkillSnapshot[]
  internalRatings           PlayerInternalRating[]
  selfRatingEvents          SelfAssessmentRatingEvent[]

  @@unique([sportId, slug])
  @@index([sportId, active])
  feedbackObservations FeedbackObservation[]
}

model Match {
  feedbackRequests FeedbackRequestMatch[]
  combinedFeedback FeedbackMatch[]
  feedbackLinks    FeedbackLink[]
  id               String                 @id @default(uuid()) @db.Uuid
  createdById      String                 @db.Uuid
  sportId          String?                @db.Uuid
  playedAt         DateTime?
  description      String?
  status           MatchStatus            @default(DRAFT)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  createdBy        User                   @relation("MatchCreator", fields: [createdById], references: [id], onDelete: Restrict)
  sport            Sport?                 @relation(fields: [sportId], references: [id], onDelete: SetNull)
  teams            MatchTeam[]
  participants     MatchParticipant[]
  feedback         Feedback[]

  @@index([createdById, createdAt])
  @@index([sportId])
}

model MatchTeam {
  id           String             @id @default(uuid()) @db.Uuid
  matchId      String             @db.Uuid
  teamNumber   Int
  name         String?
  score        Int?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  match        Match              @relation(fields: [matchId], references: [id], onDelete: Cascade)
  participants MatchParticipant[]

  @@unique([matchId, teamNumber])
  @@unique([matchId, id])
  @@index([matchId])
}

model MatchParticipant {
  id        String     @id @default(uuid()) @db.Uuid
  matchId   String     @db.Uuid
  teamId    String?    @db.Uuid
  userId    String?    @db.Uuid
  guestName String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  match     Match      @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team      MatchTeam? @relation(fields: [matchId, teamId], references: [matchId, id], onDelete: Restrict)
  user      User?      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([matchId, userId])
  @@index([matchId, teamId])
  @@index([userId])
}

model Feedback {
  submissionId                                String?                         @db.Uuid
  submission                                  FeedbackSubmission?             @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  associatedMatches                           FeedbackMatch[]
  feedbackLinkId                              String?                         @db.Uuid
  approvalRequired                            Boolean                         @default(false)
  submittedById                               String?                         @db.Uuid
  approvedById                                String?                         @db.Uuid
  approvedAt                                  DateTime?
  rejectedById                                String?                         @db.Uuid
  rejectedAt                                  DateTime?
  rejectionReason                             String?
  feedbackLink                                FeedbackLink?                   @relation(fields: [feedbackLinkId], references: [id], onDelete: Restrict)
  submittedBy                                 User?                           @relation("FeedbackSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  approvedBy                                  User?                           @relation("FeedbackApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  rejectedBy                                  User?                           @relation("FeedbackRejector", fields: [rejectedById], references: [id], onDelete: Restrict)
  id                                          String                          @id @default(uuid()) @db.Uuid
  recipientId                                 String                          @db.Uuid
  reviewerId                                  String?                         @db.Uuid
  sportId                                     String                          @db.Uuid
  matchId                                     String?                         @db.Uuid
  overallComment                              String?
  guestName                                   String?
  guestInviteNonce                            String?                         @db.Uuid
  guestInviteExpiresAt                        DateTime?
  status                                      FeedbackStatus                  @default(PUBLISHED)
  analyticsAllowed                            Boolean                         @default(false)
  evidenceAllowed                             Boolean                         @default(false)
  reviewerOverallLevelAtSubmission            String?
  reviewerSnapshotCapturedAt                  DateTime?
  reviewerSelfAssessmentUpdatedAtAtSubmission DateTime?
  reviewerSelfAssessmentIdAtSubmission        String?                         @db.Uuid
  createdAt                                   DateTime                        @default(now())
  updatedAt                                   DateTime                        @updatedAt
  recipient                                   User                            @relation("FeedbackRecipient", fields: [recipientId], references: [id], onDelete: Restrict)
  reviewer                                    User?                           @relation("FeedbackReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  sport                                       Sport                           @relation(fields: [sportId], references: [id], onDelete: Restrict)
  match                                       Match?                          @relation(fields: [matchId], references: [id], onDelete: SetNull)
  ratings                                     FeedbackRating[]
  reviewerSkillSnapshots                      FeedbackReviewerSkillSnapshot[]
  internalContributions                       InternalRatingContribution[]
  internalEvents                              PlayerInternalRatingEvent[]

  @@index([reviewerId, approvalRequired, status, createdAt, id])
  @@index([feedbackLinkId])
  @@index([submissionId])
  @@index([guestInviteNonce])
  @@index([recipientId, createdAt])
  @@index([sportId, createdAt])
  @@index([reviewerId])
  @@index([matchId])
  @@index([reviewerOverallLevelAtSubmission, sportId])
  analysisJob FeedbackAnalysisJob?
}

model FeedbackRating {
  feedbackId                           String    @db.Uuid
  skillId                              String    @db.Uuid
  rating                               Int
  comment                              String?
  // Private calculation inputs frozen when the feedback is submitted.
  reviewerInternalRatingAtSubmission   Decimal?  @db.Decimal(12, 8)
  reviewerConfidenceAtSubmission       Decimal?  @db.Decimal(14, 12)
  reviewerRawWeightAtSubmission        Decimal?  @db.Decimal(20, 12)
  reviewerEffectiveRateAtSubmission    Decimal?  @db.Decimal(14, 12)
  reviewerFinalRateAtSubmission        Decimal?  @db.Decimal(14, 12)
  reviewerAlgorithmVersionAtSubmission Int?
  reviewerInternalSnapshotCapturedAt   DateTime?
  createdAt                            DateTime  @default(now())
  updatedAt                            DateTime  @updatedAt
  feedback                             Feedback  @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  skill                                Skill     @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@id([feedbackId, skillId])
  @@index([skillId])
}

model SelfAssessment {
  id           String                      @id @default(uuid()) @db.Uuid
  userId       String                      @db.Uuid
  sportId      String                      @db.Uuid
  overallLevel String
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt
  user         User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  sport        Sport                       @relation(fields: [sportId], references: [id], onDelete: Restrict)
  ratings      SelfAssessmentRating[]
  history      SelfAssessmentRatingEvent[]

  @@unique([userId, sportId])
  @@index([userId, sportId])
}

model SelfAssessmentRating {
  selfAssessmentId String         @db.Uuid
  skillId          String         @db.Uuid
  rating           Int
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  selfAssessment   SelfAssessment @relation(fields: [selfAssessmentId], references: [id], onDelete: Cascade)
  skill            Skill          @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@id([selfAssessmentId, skillId])
  @@index([skillId])
}

model FeedbackReviewerSkillSnapshot {
  feedbackId            String   @db.Uuid
  skillId               String   @db.Uuid
  ratingAtSubmission    Int
  sourceRatingUpdatedAt DateTime
  capturedAt            DateTime
  feedback              Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  skill                 Skill    @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@id([feedbackId, skillId])
  @@index([skillId])
}

enum InternalRatingEventType {
  INITIALIZED
  FEEDBACK_APPLIED
  CORRECTION
  REBUILT
}

enum SelfRatingEventType {
  CREATED
  UPDATED
  BASELINE
}

model PlayerInternalRating {
  id               String                       @id @default(uuid()) @db.Uuid
  userId           String                       @db.Uuid
  skillId          String                       @db.Uuid
  initialRating    Decimal                      @db.Decimal(12, 8)
  currentRating    Decimal                      @db.Decimal(12, 8)
  feedbackCount    Int                          @default(0)
  algorithmVersion Int                          @default(1)
  revision         Int                          @default(1)
  createdAt        DateTime                     @default(dbgenerated("timezone('UTC', clock_timestamp())"))
  updatedAt        DateTime                     @updatedAt
  user             User                         @relation(fields: [userId], references: [id], onDelete: Restrict)
  skill            Skill                        @relation(fields: [skillId], references: [id], onDelete: Restrict)
  events           PlayerInternalRatingEvent[]
  contributions    InternalRatingContribution[]

  @@unique([userId, skillId])
  @@index([skillId])
}

model PlayerInternalRatingEvent {
  id                     String                  @id @default(uuid()) @db.Uuid
  sequence               BigInt                  @unique @default(autoincrement())
  userId                 String                  @db.Uuid
  skillId                String                  @db.Uuid
  feedbackId             String?                 @db.Uuid
  sourceKey              String?                 @unique
  type                   InternalRatingEventType
  previousRating         Decimal                 @db.Decimal(12, 8)
  submittedRating        Int?
  reviewerId             String?                 @db.Uuid
  reviewerInternalRating Decimal?                @db.Decimal(12, 8)
  rawWeight              Decimal?                @db.Decimal(20, 12)
  confidence             Decimal?                @db.Decimal(14, 12)
  effectiveRate          Decimal?                @db.Decimal(14, 12)
  finalRate              Decimal?                @db.Decimal(14, 12)
  delta                  Decimal                 @db.Decimal(12, 8)
  newRating              Decimal                 @db.Decimal(12, 8)
  algorithmVersion       Int                     @default(1)
  revision               Int                     @default(1)
  chartPoint             Boolean                 @default(true)
  createdAt              DateTime                @default(dbgenerated("timezone('UTC', clock_timestamp())"))
  effectiveAt            DateTime
  rating                 PlayerInternalRating    @relation(fields: [userId, skillId], references: [userId, skillId], onDelete: Restrict)
  feedback               Feedback?               @relation(fields: [feedbackId], references: [id], onDelete: Restrict)

  @@index([userId, skillId, revision, effectiveAt, sequence])
}

model SelfAssessmentRatingEvent {
  id               String              @id @default(uuid()) @db.Uuid
  sequence         BigInt              @unique @default(autoincrement())
  userId           String              @db.Uuid
  skillId          String              @db.Uuid
  selfAssessmentId String              @db.Uuid
  previousRating   Int?
  newRating        Int
  type             SelfRatingEventType
  createdAt        DateTime            @default(dbgenerated("timezone('UTC', clock_timestamp())"))
  user             User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  skill            Skill               @relation(fields: [skillId], references: [id], onDelete: Restrict)
  selfAssessment   SelfAssessment      @relation(fields: [selfAssessmentId], references: [id], onDelete: Restrict)

  @@index([userId, skillId, createdAt, sequence])
}

// Private, stable reviewer snapshots and current source eligibility for replay.
model InternalRatingContribution {
  id                     String               @id @default(uuid()) @db.Uuid
  sequence               BigInt               @unique @default(autoincrement())
  feedbackId             String               @db.Uuid
  userId                 String               @db.Uuid
  skillId                String               @db.Uuid
  reviewerId             String?              @db.Uuid
  reviewerInternalRating Decimal?             @db.Decimal(12, 8)
  rawWeight              Decimal              @db.Decimal(20, 12)
  confidence             Decimal              @db.Decimal(14, 12)
  effectiveRate          Decimal              @db.Decimal(14, 12)
  finalRate              Decimal              @db.Decimal(14, 12)
  algorithmVersion       Int                  @default(1)
  // Registered reviewer ID or guest invite nonce; one influence per UTC day.
  identityKey            String
  submittedRating        Int
  published              Boolean              @default(false)
  eligible               Boolean              @default(false)
  effectiveAt            DateTime             @default(dbgenerated("timezone('UTC', clock_timestamp())"))
  createdAt              DateTime             @default(dbgenerated("timezone('UTC', clock_timestamp())"))
  rating                 PlayerInternalRating @relation(fields: [userId, skillId], references: [userId, skillId], onDelete: Restrict)
  reviewer               User?                @relation("InternalReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  feedback               Feedback             @relation(fields: [feedbackId], references: [id], onDelete: Restrict)

  @@unique([feedbackId, skillId])
  @@index([userId, skillId, sequence])
  @@index([userId, skillId, eligible, reviewerId])
}

model FeedbackLink {
  mode               FeedbackReviewMode     @default(INDIVIDUAL_MATCHES)
  requestMatches     FeedbackRequestMatch[]
  submissions        FeedbackSubmission[]
  lastSubmittedAt    DateTime?
  id                 String                 @id @default(uuid()) @db.Uuid
  recipientId        String                 @db.Uuid
  assignedReviewerId String?                @db.Uuid
  sportId            String                 @db.Uuid
  matchId            String?                @db.Uuid
  tokenHash          String                 @unique
  expiresAt          DateTime
  revokedAt          DateTime?
  createdAt          DateTime               @default(now())
  recipient          User                   @relation("LinkRecipient", fields: [recipientId], references: [id], onDelete: Restrict)
  assignedReviewer   User?                  @relation("LinkReviewer", fields: [assignedReviewerId], references: [id], onDelete: Restrict)
  sport              Sport                  @relation(fields: [sportId], references: [id], onDelete: Restrict)
  match              Match?                 @relation(fields: [matchId], references: [id], onDelete: SetNull)
  feedback           Feedback[]

  @@index([recipientId, createdAt])
  @@index([assignedReviewerId])
}

enum FeedbackReviewMode {
  INDIVIDUAL_MATCHES
  COMBINED_MATCHES
}

model FeedbackRequestMatch {
  feedbackLinkId String       @db.Uuid
  matchId        String       @db.Uuid
  displayOrder   Int
  feedbackLink   FeedbackLink @relation(fields: [feedbackLinkId], references: [id], onDelete: Cascade)
  match          Match        @relation(fields: [matchId], references: [id], onDelete: Restrict)

  @@id([feedbackLinkId, matchId])
  @@unique([feedbackLinkId, displayOrder])
  @@index([matchId])
}

model FeedbackMatch {
  feedbackId String   @db.Uuid
  matchId    String   @db.Uuid
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  match      Match    @relation(fields: [matchId], references: [id], onDelete: Restrict)

  @@id([feedbackId, matchId])
  @@index([matchId])
}

model FeedbackSubmission {
  id                 String       @id @default(uuid()) @db.Uuid
  feedbackLinkId     String       @db.Uuid
  clientSubmissionId String       @db.Uuid
  payloadHash        String
  createdAt          DateTime     @default(now())
  feedbackLink       FeedbackLink @relation(fields: [feedbackLinkId], references: [id], onDelete: Restrict)
  feedback           Feedback[]

  @@unique([feedbackLinkId, clientSubmissionId])
}

// Derived, private analysis. Existing Feedback/FeedbackRating remain authoritative.
model FeedbackTheme {
  id           String                @id
  name         String
  skillSlugs   String[]
  active       Boolean               @default(true)
  version      Int                   @default(1)
  observations FeedbackObservation[]
}

model FeedbackAnalysisJob {
  feedbackId    String                  @id @db.Uuid
  generation    Int                     @default(1)
  status        String                  @default("PENDING")
  attempts      Int                     @default(0)
  runAfter      DateTime                @default(now())
  leaseToken    String?                 @db.Uuid
  leaseUntil    DateTime?
  sourceHash    String?
  provider      String?
  modelVersion  String?
  promptVersion String?
  moderation    String                  @default("UNASSESSED")
  errorCode     String?
  processedAt   DateTime?
  updatedAt     DateTime                @updatedAt
  feedback      Feedback                @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  observations  FeedbackObservation[]
  runs          FeedbackExtractionRun[]

  @@index([status, runAfter])
}

model FeedbackExtractionRun {
  id            String              @id @default(uuid()) @db.Uuid
  feedbackId    String              @db.Uuid
  generation    Int
  status        String              @default("STARTED")
  provider      String
  modelVersion  String
  promptVersion String
  sourceHash    String?
  apiAttempts   Int                 @default(0)
  inputTokens   Int                 @default(0)
  outputTokens  Int                 @default(0)
  moderation    String?
  unknownThemes String[]            @default([])
  errorCode     String?
  startedAt     DateTime            @default(now())
  finishedAt    DateTime?
  job           FeedbackAnalysisJob @relation(fields: [feedbackId], references: [feedbackId], onDelete: Cascade)

  @@index([feedbackId, startedAt])
}

model FeedbackObservation {
  id                String                         @id @default(uuid()) @db.Uuid
  feedbackId        String                         @db.Uuid
  generation        Int
  sourceKey         String
  skillId           String?                        @db.Uuid
  themeId           String
  sentiment         String
  evidence          String
  fingerprint       String
  sourceHash        String
  provider          String
  modelVersion      String
  promptVersion     String
  feedbackCreatedAt DateTime
  createdAt         DateTime                       @default(now())
  job               FeedbackAnalysisJob            @relation(fields: [feedbackId], references: [feedbackId], onDelete: Cascade)
  skill             Skill?                         @relation(fields: [skillId], references: [id], onDelete: Restrict)
  theme             FeedbackTheme                  @relation(fields: [themeId], references: [id], onDelete: Restrict)
  embeddingJobs     FeedbackEmbeddingJob[]
  embeddings        FeedbackObservationEmbedding[]

  @@unique([feedbackId, generation, fingerprint])
  @@index([feedbackId, themeId])
}

model FeedbackEmbeddingJob {
  observationId   String              @db.Uuid
  provider        String
  model           String
  modelVersion    String
  dimensions      Int
  templateVersion String
  sourceHash      String
  status          String              @default("PENDING")
  attempts        Int                 @default(0)
  runAfter        DateTime            @default(now())
  leaseToken      String?             @db.Uuid
  leaseUntil      DateTime?
  errorCode       String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  observation     FeedbackObservation @relation(fields: [observationId], references: [id], onDelete: Cascade)

  @@id([observationId, provider, model, modelVersion, dimensions, templateVersion])
  @@index([status, runAfter])
}

model FeedbackObservationEmbedding {
  observationId   String                @db.Uuid
  provider        String
  model           String
  modelVersion    String
  dimensions      Int
  templateVersion String
  sourceHash      String
  vector          Unsupported("vector")
  createdAt       DateTime              @default(now())
  observation     FeedbackObservation   @relation(fields: [observationId], references: [id], onDelete: Cascade)

  @@id([observationId, provider, model, modelVersion, dimensions, templateVersion])
}

model PlayerFeedbackAnalysisProfile {
  userId           String    @db.Uuid
  sportId          String    @db.Uuid
  algorithmVersion Int       @default(0)
  expiresAt        DateTime?
  rebuildError     String?
  rebuildErrorAt   DateTime?
  rebuildAttemptAt DateTime?
  rebuildRetryAt   DateTime?
  revision         Int       @default(1)
  builtRevision    Int       @default(0)
  stale            Boolean   @default(true)
  data             Json      @default("{}")
  builtAt          DateTime?
  invalidatedAt    DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sport            Sport     @relation(fields: [sportId], references: [id], onDelete: Cascade)

  @@id([userId, sportId])
}

model AiCoachConversation {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  sportId String @db.Uuid
  title String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  sport Sport @relation(fields:[sportId], references:[id], onDelete:Restrict)
  turns AiCoachTurn[]
  @@unique([userId,id])
  @@index([userId,updatedAt,id])
  @@index([expiresAt])
}
model AiCoachTurn {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  conversationId String @db.Uuid
  clientRequestId String @db.Uuid
  requestHash String
  question String
  status String @default("PENDING")
  response Json?
  sourceRevision Int?
  sourceAsOf String?
  model String?
  promptVersion String
  inputTokens Int @default(0)
  outputTokens Int @default(0)
  durationMs Int @default(0)
  toolTrace Json @default("[]")
  errorCode String?
  startedAt DateTime @default(now())
  completedAt DateTime?
  conversation AiCoachConversation @relation(fields:[userId,conversationId],references:[userId,id],onDelete:Cascade)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@unique([userId,clientRequestId])
  @@index([conversationId,startedAt,id])
  @@index([userId,startedAt])
}
model AiCoachUsage {
  userId String @db.Uuid
  day DateTime @db.Date
  requests Int @default(0)
  reservedTokens Int @default(0)
  spentTokens Int @default(0)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@id([userId,day])
}
