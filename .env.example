NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://sports:sports@localhost:5432/sports?schema=public
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=15m
GUEST_INVITE_TTL_MINUTES=1440
CORS_ORIGINS=http://localhost:3001,http://localhost:8081

# Internal skill rating V1 (optional; defaults shown)
RATING_BASE_RATE=0.20
RATING_NORMALIZATION=20
RATING_NEW_CONFIDENCE=0.10
RATING_SOME_CONFIDENCE=0.35
RATING_ESTABLISHED_CONFIDENCE=0.75
RATING_STRONG_CONFIDENCE=1.00
RATING_SOME_THRESHOLD=1
RATING_ESTABLISHED_THRESHOLD=5
RATING_STRONG_THRESHOLD=10
RATING_GUEST_CONFIDENCE=0.05

# Optional private feedback analysis worker (separate from the HTTP server).
# Requires the feedback-processing migration and pgvector on PostgreSQL.
FEEDBACK_ANALYSIS_ENABLED=false
OPENAI_API_KEY=
FEEDBACK_EXTRACTION_MODEL=gpt-4.1-mini
FEEDBACK_EMBEDDING_MODEL=text-embedding-3-small
FEEDBACK_EMBEDDING_VERSION=text-embedding-3-small-v1
FEEDBACK_EMBEDDING_DIMENSIONS=1536

# AI Coach (backend only; does not change extraction or embedding models).
OPENAI_CHAT_MODEL=gpt-6.1-sol
OPENAI_CHAT_FALLBACK_MODEL=gpt-6-luna
AI_CHAT_TIMEOUT_MS=60000
AI_CHAT_MAX_TOTAL_TOKENS=64000
AI_CHAT_DAILY_TOKENS=200000
AI_CHAT_DAILY_REQUESTS=30
AI_CHAT_RETENTION_DAYS=90
