NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://sports:sports@localhost:5432/sports?schema=public
GUEST_INVITE_TTL_MINUTES=1440
CORS_ORIGINS=http://localhost:3001,http://localhost:8081

# Internal skill rating V1 (optional; defaults shown)
RATING_BASE_RATE=0.20
RATING_NORMALIZATION=20
RATING_NEW_CONFIDENCE=0.10
RATING_SOME_CONFIDENCE=0.35
RATING_ESTABLISHED_CONFIDENCE=0.75
RATING_STRONG_CONFIDENCE=1.00
RATING_SOME_THRESHOLD=1
RATING_ESTABLISHED_THRESHOLD=5
RATING_STRONG_THRESHOLD=10
RATING_GUEST_CONFIDENCE=0.05

# Optional private feedback analysis worker (separate from the HTTP server).
# Requires the feedback-processing migration and pgvector on PostgreSQL.
FEEDBACK_ANALYSIS_ENABLED=false
OPENAI_API_KEY=
FEEDBACK_EXTRACTION_MODEL=gpt-4.1-mini
FEEDBACK_EMBEDDING_MODEL=text-embedding-3-small
FEEDBACK_EMBEDDING_VERSION=text-embedding-3-small-v1
FEEDBACK_EMBEDDING_DIMENSIONS=1536

# AI Coach (backend only; does not change extraction or embedding models).
OPENAI_CHAT_MODEL=gpt-6.1-sol
OPENAI_CHAT_FALLBACK_MODEL=gpt-6-luna
AI_CHAT_TIMEOUT_MS=60000
AI_CHAT_MAX_TOTAL_TOKENS=64000
AI_CHAT_DAILY_TOKENS=200000
AI_CHAT_DAILY_REQUESTS=30
AI_CHAT_RETENTION_DAYS=90

# Optional backfill planning budgets in USD per operation (not live prices or a spending limit).
# Leave unset to report costs as unknown; operation counts are still shown.
# FEEDBACK_ESTIMATED_EXTRACTION_USD_PER_REVIEW=
# FEEDBACK_ESTIMATED_EMBEDDING_USD_PER_OBSERVATION=

# Optional training catalog seed: existing Clerk user ID with trusted COACH or ADMIN metadata.
TRAINING_SEED_EDITOR_ID=
# Private video storage is opt-in; library CRUD works without it.
TRAINING_STORAGE_ENABLED=false
TRAINING_S3_ENDPOINT=
TRAINING_S3_REGION=auto
TRAINING_S3_BUCKET=
TRAINING_S3_ACCESS_KEY_ID=
TRAINING_S3_SECRET_ACCESS_KEY=
TRAINING_S3_FORCE_PATH_STYLE=false
TRAINING_UPLOAD_URL_SECONDS=180
TRAINING_PLAYBACK_URL_SECONDS=120
TRAINING_MAX_VIDEO_BYTES=104857600
TRAINING_MAX_VIDEO_DURATION_MS=30000
TRAINING_MAX_PLAYER_VIDEOS=30
TRAINING_MAX_REFERENCES_PER_DRILL=100
TRAINING_VIDEO_RETENTION_DAYS=30

# CPU video worker (separate process). No worker => honest unavailable state.
VIDEO_PYTHON=.venv-video/bin/python
VIDEO_SAMPLE_FPS=10
VIDEO_MIN_VISIBILITY=0.6
VIDEO_MIN_VALID_RATIO=0.65
VIDEO_MAX_DURATION_MS=30000
# VIDEO_FFMPEG=/usr/bin/ffmpeg
# VIDEO_FFPROBE=/usr/bin/ffprobe
# VIDEO_POSE_MODEL=video-worker/models/pose_landmarker_full.task
# HTTP permitted only for loopback development endpoints outside NODE_ENV=production.
TRAINING_S3_ALLOW_LOCAL_HTTP=false
# Requires separate per-upload opt-in; raw videos/frames/landmarks never sent.
TRAINING_AI_EXPLANATIONS_ENABLED=false
# Uses OPENAI_CHAT_MODEL, the existing AI Coach model, when enabled.

# Public frontend origin used for guest links and allowed browser origins.
FRONTEND_URL=http://localhost:3001

# Clerk is the only account/session/profile authority. Backend service secrets only.
CLERK_SECRET_KEY=
# Exact token issuer from this Clerk instance, e.g. https://your-instance.clerk.accounts.dev
CLERK_ISSUER=
CLERK_AUTHORIZED_PARTIES=http://localhost:3001
# Optional PEM public key for networkless token-signature verification; live session/user status is still checked.
CLERK_JWT_KEY=
# Optional only if you configured a matching audience in Clerk.
CLERK_AUDIENCE=
CLERK_WEBHOOK_SIGNING_SECRET=
CLERK_DELETION_WORKER_ENABLED=true
# Independent signing key for guest feedback followups/withdrawal capabilities; never account authentication.
GUEST_CAPABILITY_SECRET=
# Manual approval for deleting old private objects queued by the fresh-start cutover.
CLERK_ALLOW_CUTOVER_MEDIA_CLEANUP=false
