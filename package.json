{
  "name": "multi-sport-feedback-backend",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "build": "prisma generate && nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/src/main.js",
    "lint": "eslint \"{src,test,prisma}/**/*.ts\"",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand --testPathIgnorePatterns=integration",
    "test:integration": "jest --runInBand test/integration",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx --env-file=.env prisma/seed.ts",
    "prisma:seed:deploy": "node dist/prisma/seed.js",
    "ratings:backfill": "node dist/prisma/backfill-internal-ratings.js",
    "db:deploy": "node dist/src/auth/clerk/deploy-preflight.js && pnpm prisma:deploy && pnpm prisma:seed:deploy",
    "feedback:process": "node dist/src/feedback-processing/cli.js",
    "feedback:watch": "node --env-file=.env dist/src/feedback-processing/cli.js watch 10 --execute",
    "coach:prune": "node dist/prisma/prune-ai-coach.js",
    "feedback:preview": "node dist/src/feedback-processing/cli.js enqueue --all --dry-run",
    "feedback:backfill": "node dist/src/feedback-processing/cli.js enqueue --all",
    "feedback:work": "node dist/src/feedback-processing/cli.js work --all",
    "feedback:ready": "node dist/src/feedback-processing/cli.js status --ready",
    "feedback:profiles": "node dist/src/feedback-processing/cli.js profiles-all",
    "training:seed": "node dist/src/training/cli.js seed",
    "training:maintenance": "node dist/src/training/cli.js maintenance",
    "video:worker": "node dist/src/training/motion-worker.js",
    "video:health": "node dist/src/training/motion-worker.js health",
    "test:video:python": ".venv-video/bin/python -m unittest discover -s video-worker/tests -v",
    "test:video:smoke": "tsc -p tsconfig.video-smoke.json && node dist/video-worker/smoke.js",
    "clerk:cutover": "node dist/src/auth/clerk/cutover.js",
    "clerk:deletions": "node dist/src/auth/clerk/deletions-cli.js"
  },
  "dependencies": {
    "@apollo/server": "^5.1.0",
    "@as-integrations/express5": "^1.1.2",
    "@aws-sdk/client-s3": "^3.1172.0",
    "@aws-sdk/s3-request-presigner": "^3.1172.0",
    "@clerk/backend": "3.31.3",
    "@nestjs/apollo": "^13.2.0",
    "@nestjs/common": "^11.1.9",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.9",
    "@nestjs/graphql": "^13.2.0",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/platform-express": "^11.1.9",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "^6.19.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "graphql": "^16.11.0",
    "graphql-depth-limit": "^1.1.0",
    "graphql-query-complexity": "^0.12.0",
    "helmet": "^8.1.0",
    "openai": "^7.57.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.9",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.18.12",
    "jest": "^30.2.0",
    "prisma": "^6.19.0",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.4.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild"
    ]
  },
  "engines": {
    "node": ">=22"
  }
}
